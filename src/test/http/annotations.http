### 1. Admin accessing @PreAuthorize("hasRole('ADMIN')") (200 OK)
GET http://localhost:8080/api/v1/cars/hello/admin
Authorization: Basic admin admin
Accept: application/json

> {%
    client.test("Admin can access hello/admin", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

###

### 2. User accessing @PreAuthorize("hasRole('ADMIN')") (403 Forbidden)
GET http://localhost:8080/api/v1/cars/hello/admin
Authorization: Basic user user
Accept: application/json

> {%
    client.test("User forbidden from hello/admin", function() {
        client.assert(response.status === 403, "Response status is not 403");
    });
%}

###

### 3. Anonymous accessing @PreAuthorize("hasRole('ADMIN')") (401 Unauthorized)
GET http://localhost:8080/api/v1/cars/hello/admin
Accept: application/json

> {%
    client.test("Anonymous unauthorized for hello/admin", function() {
        client.assert(response.status === 401, "Response status is not 401");
    });
%}

